  {
   "location": "spectral_ranges[0].citations[0]",
   "doc": "S01",
   "page": 10,
   "quote": "NIR spectra (780-2500 nm) contain predominantly overtones and component bands of fundamental vibrations",
   "claim_kind": "general",
   "quote_status": "exact",
   "start": 934,
   "end": 1037,
   "page_sha256": "7f51502ef68d726d946f2ea375a747d26ae84b8f2449d1858d30b38c50d3a666",
