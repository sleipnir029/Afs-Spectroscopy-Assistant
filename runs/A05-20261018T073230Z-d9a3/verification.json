   "scope_status": "ok",
   "verified": true
  },
  {
   "location": "recommendations[0].citations[0]",
   "doc": "S01",
   "page": 17,
   "quote": "NIR Reflection is primarily used for opaque or highly concentrated dairy products, such as yogurt, butter, or whole milk concentrates.",
   "claim_kind": "application_precedent",
   "quote_status": "exact",
   "start": 801,
   "end": 935,
