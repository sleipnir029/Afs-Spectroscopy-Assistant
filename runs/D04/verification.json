  {
   "location": "premise_checks[1].citations[0]",
   "doc": "S01",
   "page": 2,
   "quote": "Fiber optic probes and cells are being integrated into reactors and production lines of ongoing technological processes, enabling on-site online analysis and obtaining results in near real time.",
   "claim_kind": "general",
   "quote_status": "exact",
   "start": 2641,
