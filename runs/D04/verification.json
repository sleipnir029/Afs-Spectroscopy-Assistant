 "citations": [
  {
   "location": "premise_checks[0].citations[0]",
   "doc": "REF",
   "page": 3,
   "quote": "A feasibility plan needs representative samples or process states, independent reference measurements, a defined comparison and a go/no-go basis.",
   "claim_kind": "general",
   "quote_status": "not_found",
   "start": null,
