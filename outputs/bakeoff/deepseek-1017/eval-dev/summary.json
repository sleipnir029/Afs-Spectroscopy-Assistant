  {
   "checks": "no hard verification failure left open",
   "criterion": "technical",
   "id": "no_open_failures"
  },
  {
   "checks": "no flagged item or unsupported figure left",
   "criterion": "grounding",
   "id": "no_flagged_figures"
  },
  {
   "checks": "no currency sign, code or word outside quoted evidence and the enquiry",
   "criterion": "technical",
   "id": "no_currency"
  },
  {
   "checks": "no guarantee, certainty, approval or readiness wording",
   "criterion": "technical",
   "id": "no_certainty_wording"
