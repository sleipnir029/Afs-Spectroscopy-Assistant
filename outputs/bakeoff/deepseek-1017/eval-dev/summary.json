  },
  {
   "checks": "at least two real plan steps, reference and decision basis",
   "criterion": "feasibility",
   "id": "feasibility_plan"
  },
  {
   "checks": "premise/certainty/clinical cues checked; status agrees",
   "criterion": "clarification",
   "id": "premise_flags"
  },
  {
   "checks": "questions when unknowns are open; top 3 in the Answer",
   "criterion": "clarification",
   "id": "questions_present"
  },
  {
   "checks": "each question names what it affects; one changes the option",
   "criterion": "clarification",
   "id": "questions_tied_to_options"
  },
  {
   "checks": "Answer model text within about 600 words",
   "criterion": "explainability",
   "id": "answer_length"
  },
  {
   "checks": "external items only in the secondary section, with quote and URL",
   "criterion": "grounding",
   "id": "external_secondary"
  },
  {
   "checks": "external items re-verify offline to the recorded result",
